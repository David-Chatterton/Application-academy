# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/

# Local environment variables and credentials
.env
.env.*
!.env.example
!.env.*.example

# Logs and test artifacts
*.log
coverage/
playwright-report/
test-results/

# Python artifacts from local development tools
__pycache__/
*.py[cod]
.venv/
venv/

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# dist/ contains the current application source; keep it tracked.
# .openai/hosting.json is tracked deployment configuration, not a credential.
